rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Master Gate: Checks membership in a group
    function isGroupMember(groupId, userId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(userId));
    }

    // User Profile schema validation
    function isValidUserProfile(data) {
      return (data.get('athleteName', null) == null || (data.get('athleteName', null) is string && data.get('athleteName', '').size() >= 1 && data.get('athleteName', '').size() <= 200))
        && (data.get('email', null) == null || (data.get('email', null) is string && data.get('email', '').size() <= 100))
        && (data.get('registeredAt', null) == null || data.get('registeredAt', null) is string || data.get('registeredAt', null) is timestamp)
        && (data.get('photoURL', null) == null || data.get('photoURL', null) is string)
        && (data.get('role', null) == null || data.get('role', null) is string)
        && (data.get('joinedGroups', null) == null || data.get('joinedGroups', null) is map)
        && (data.get('stravaIntegration', null) == null || data.get('stravaIntegration', null) is map);
    }

    // Group schema validation
    function isValidGroup(data) {
      return data.get('id', null) is string
        && data.get('id', '').size() >= 1
        && data.get('id', '').size() <= 64
        && data.get('name', null) is string
        && data.get('name', '').size() >= 1
        && data.get('name', '').size() <= 200
        && data.get('description', null) is string
        && data.get('description', '').size() <= 2000
        && data.get('creatorId', null) is string
        && (data.get('creatorId', null) == request.auth.uid || data.get('creatorId', null) == 'local_proxy' || (request.auth.token.email == 'jhonatasmaranata@gmail.com' && request.auth.token.email_verified == true))
        && data.get('inviteCode', null) is string
        && data.get('inviteCode', '').size() >= 1
        && data.get('inviteCode', '').size() <= 64
        && data.get('createdAt', null) is string
        && data.get('rules', null) is map
        && data.get('rules', {}).get('startDate', null) is string
        && data.get('rules', {}).get('gymPointsPerCheckIn', null) is number
        && data.get('rules', {}).get('distanceMultiplier', null) is number
        && data.get('rules', {}).get('comboPointsPerDay', null) is number
        && (data.get('rules', {}).get('corridaMultiplier', null) == null || data.get('rules', {}).get('corridaMultiplier', null) is number)
        && (data.get('rules', {}).get('caminhadaMultiplier', null) == null || data.get('rules', {}).get('caminhadaMultiplier', null) is number)
        && (data.get('rules', {}).get('ciclismoMultiplier', null) == null || data.get('rules', {}).get('ciclismoMultiplier', null) is number)
        && (data.get('rules', {}).get('natacaoMultiplier', null) == null || data.get('rules', {}).get('natacaoMultiplier', null) is number);
    }

    // Group Member schema validation
    function isValidGroupMember(data) {
      return data.get('userId', null) is string
        && data.get('userId', null) == request.auth.uid
        && (data.get('athleteName', null) == null || (data.get('athleteName', null) is string && data.get('athleteName', '').size() >= 1 && data.get('athleteName', '').size() <= 200))
        && (data.get('email', null) == null || (data.get('email', null) is string && data.get('email', '').size() <= 100))
        && (data.get('role', null) == null || data.get('role', null) is string)
        && (data.get('joinedAt', null) == null || data.get('joinedAt', null) is string)
        && (data.get('photoURL', null) == null || data.get('photoURL', null) is string);
    }

    // Workout Activity Schema Validation
    function isValidActivity(data) {
      return data.get('name', null) is string
        && data.get('name', '').size() >= 1
        && data.get('name', '').size() <= 200
        && data.get('type', null) is string
        && data.get('type', '').size() >= 1
        && data.get('type', '').size() <= 200
        && data.get('distance', null) is number
        && data.get('distance', 0) >= 0.0
        && data.get('distance', 0) <= 1000.0
        && data.get('date', null) is string
        && data.get('date', '').size() == 10
        && data.get('userId', null) is string
        && data.get('userId', null) == request.auth.uid
        && data.get('timestamp', null) is string
        && data.get('timestamp', '').size() >= 2
        && data.get('timestamp', '').size() <= 30
        && data.get('checkInCode', '') is string
        && data.get('checkInCode', '').size() <= 100
        && data.get('isGymWorkout', null) is bool
        && (data.get('customActivityName', null) == null || (data.get('customActivityName', null) is string && data.get('customActivityName', '').size() <= 100))
        && (data.get('calories', null) == null || data.get('calories', null) is number);
    }

    // Challenge Goal validation
    function isValidChallengeGoal(data) {
      return data.get('id', null) is string
        && data.get('athleteName', null) is string
        && data.get('type', null) is string;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && isValidUserProfile(incoming());
      allow update: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId
        && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Groups Collection rules
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(groupId) 
        && isValidGroup(incoming());
      allow update: if isSignedIn() 
        && isValidId(groupId) 
        && (existing().creatorId == request.auth.uid || existing().creatorId == 'local_proxy' || (request.auth.token.email == 'jhonatasmaranata@gmail.com' && request.auth.token.email_verified == true))
        && isValidGroup(incoming())
        && incoming().creatorId == existing().creatorId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() 
        && isValidId(groupId) 
        && existing().creatorId == request.auth.uid;

      // Group Members subcollection rules
      match /members/{memberId} {
        allow read: if true;
        allow create: if isSignedIn() 
          && isValidId(memberId) 
          && memberId == request.auth.uid 
          && isValidGroupMember(incoming());
        allow update: if isSignedIn() 
          && isValidId(memberId) 
          && memberId == request.auth.uid;
        allow delete: if isSignedIn() 
          && (memberId == request.auth.uid || get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
      }

      // Group Activities subcollection rules
      match /activities/{activityId} {
        allow read: if true;
        allow create: if isSignedIn() 
          && isValidId(activityId) 
          && isGroupMember(groupId, request.auth.uid) 
          && isValidActivity(incoming());
        allow update: if isSignedIn() 
          && isValidId(activityId) 
          && isGroupMember(groupId, request.auth.uid) 
          && existing().userId == request.auth.uid 
          && isValidActivity(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isSignedIn() 
          && isValidId(activityId) 
          && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid);
      }

      // Group Challenges targets rules
      match /challenges/{challengeId} {
        allow read: if true;
        allow create, update: if isSignedIn() 
          && isValidId(challengeId) 
          && challengeId == request.auth.uid 
          && isGroupMember(groupId, request.auth.uid)
          && isValidChallengeGoal(incoming());
        allow delete: if isSignedIn() 
          && isValidId(challengeId) 
          && challengeId == request.auth.uid;
      }
    }
  }
}
